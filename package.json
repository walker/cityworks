{
  "name": "cityworks",
  "version": "2.3.0",
  "description": "A Cityworks API wrapper",
  "main": "dist/index.js",
  "module": "dist/index.m.js",
  "source": "src/index.ts",
  "files": [
    "dist/*.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.m.js",
    "dist/index.m.js.map",
    "dist/index.modern.mjs",
    "dist/index.modern.mjs.map"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "microbundle watch --target node --format cjs,esm,modern --compress",
    "build": "microbundle --target node --format cjs,esm,modern --compress",
    "test": "mocha -R spec --recursive ./test/ -g ",
    "fulltest": "mocha -R spec --recursive ./test/",
    "contracts": "CW_RECORD_CONTRACTS=1 mocha -R dot --recursive ./test/",
    "test:live": "mocha -R spec ./live/liveContract.cjs",
    "test:live:comments": "mocha -R spec ./live/liveComments.cjs",
    "test:live:attachments": "mocha -R spec ./live/liveAttachments.cjs",
    "test:live:requests": "mocha -R spec ./live/liveRequests.cjs",
    "test:live:activities": "mocha -R spec ./live/liveActivities.cjs",
    "test:live:case": "mocha -R spec ./live/liveCase.cjs",
    "test:live:query": "mocha -R spec ./live/liveQuery.cjs",
    "test:live:inspection-links": "mocha -R spec ./live/liveInspectionRelationships.cjs",
    "docs": "typedoc --tsconfig ./tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walker/cityworks.git"
  },
  "keywords": [
    "cityworks",
    "api",
    "wrapper",
    "government",
    "local",
    "asset"
  ],
  "author": "Walker",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/walker/cityworks/issues"
  },
  "homepage": "https://walker.github.io/cityworks/",
  "devDependencies": {
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "dotenv": "^17.4.1",
    "jsdoc-to-markdown": "^9.1.3",
    "microbundle": "^0.15.1",
    "mocha": "^11.7.5",
    "typedoc": "^0.28.18",
    "winston": "^3.19.0"
  },
  "dependencies": {
    "@types/node": "^25.3.5",
    "axios": "^1.14.0",
    "dotenv": "~17.3.1",
    "form-data": "^4.0.5",
    "lodash": "^4.18.1",
    "mime-types": "^3.0.2",
    "reversible-map": "^1.0.1",
    "typescript": "^6.0.2"
  }
}
